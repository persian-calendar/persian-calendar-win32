#include <winresrc.h>
#include "persian-calendar.rc.h"

LANGUAGE LANG_PERSIAN, SUBLANG_NEUTRAL

IDI_APP_ICON ICON "persian-calendar.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION    5,7,23,0
PRODUCTVERSION 5,7,23,0
FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
FILEFLAGS      0x1L
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "042904b0" // Language: Persian (0429), Character Set: Unicode (04b0)
        BEGIN
            VALUE "CompanyName",      "Persian Calendar"
            VALUE "FileDescription",  "Persian Calendar"
            VALUE "FileVersion",      "5.7.23.0"
            VALUE "InternalName",     "PersianCalendar.exe"
            VALUE "LegalCopyright",   "Licensed under LGPL-3.0-or-later."
            VALUE "OriginalFilename", "PersianCalendar.exe"
            VALUE "ProductName",      "Persian Calendar"
            VALUE "ProductVersion",   "5.7.23.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0429, 0x04b0
    END
END
